index acf1cdd..0bc3ae5 100644
--- a/rom/v2_cart_home.asm
+++ b/rom/v2_cart_home.asm
@@ -34,7 +34,9 @@ MATH_RND_SEED:
 
 ; CART_LOAD -- map the program image (DOCK chunk 3), check it, copy it, unmap it. Called by CART_RUN
 ; (rom/exrom_v2_cart.asm). Copies SYM_COUNTS, the bytecode to VM_CODE_BASE, and sets EMIT_PTR to its
-; end. CF = refused: another image format or ROM build, or a bad length. Interrupts are off while
+; end; copies the package image (if any) to its window and sets V2_PACKAGE_LEN, as LOAD "NAME" EXT
+; does before calling its install entry (CART_RUN calls it). CF = refused: another image format or
+; ROM build, or a bad length. Interrupts are off while
 ; chunk 3 is DOCK and on again at the end. Destroys AF, BC, DE, HL.
 CART_LOAD:
     di
@@ -77,7 +79,22 @@ CART_LOAD:
     pop bc
     ld de,VM_CODE_BASE
     ldir
-    ld (EMIT_PTR),de                 ; CF clear (ldir keeps it)
+    ld (EMIT_PTR),de
+    ld c,(hl)
+    inc hl
+    ld b,(hl)                        ; BC = package length, 0 (none) .. the window's size
+    inc hl
+    ld (CART_PACKAGE_LEN),bc
+    ld a,b
+    or c
+    ret z                            ; no package (CF clear from the `or`)
+    push hl
+    ld hl,EXTENSION_MODULE_LIMIT-EXTENSION_MODULE_BASE
+    sbc hl,bc                        ; (CF clear from the `or`)
+    pop hl
+    ret c
+    ld de,EXTENSION_MODULE_BASE
+    ldir                             ; CF clear (ldir keeps it)
     ret
 
