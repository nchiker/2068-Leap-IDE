diff --git a/include/v2_cart.inc b/include/v2_cart.inc
new file mode 100644
index 0000000..085ed9c
--- /dev/null
+++ b/include/v2_cart.inc
@@ -0,0 +1,46 @@
+; ============================================================================
+; include/v2_cart.inc -- CART: the runtime cartridge build (-DV2_CARTRIDGE).
+;
+; The cartridge runs one precompiled program on a stock TS2068 (stock HOME ROM and EXROM
+; installed). Leap's HOME image is DOCK chunks 0-1 and its EXROM image DOCK chunk 6, both at their
+; usual addresses, so Leap's code always comes from the DOCK (port $FF bit 7 stays 0) and the stock
+; ROMs are never selected again after the stock ROM's LROS hand-off. The program image is DOCK
+; chunk 3, mapped only while it is copied to RAM. See ../Docs/LEAP_CARTRIDGE_BUILD.md.
+;
+; Every routine of the normal build keeps its address (the changes are same-size patches in
+; kernel/bank/bank.asm, the LROS header in the reset bytes, and new code in the images' free
+; space), so the compiler and the VM are byte-identical to the release the bytecode is compiled on.
+; ============================================================================
+    IFNDEF V2_CART_INC
+    DEFINE V2_CART_INC
+
+CART_HSR_RUN     EQU %01000011   ; chunks 0, 1, 6 DOCK: Leap HOME and EXROM (BANK_EXROM_DEPTH >= 1)
+CART_HSR_PKG     EQU %00000011   ; chunk 6 HOME RAM: a package's window (OP_CALL_EXT, depth 0)
+CART_HSR_LOAD    EQU %01001011   ; + chunk 3: the program image, while CART_RUN copies it
+CART_CHUNK_SPEC  EQU %10111100   ; LROS chunk spec, low-active: chunks 0, 1, 6 DOCK at the hand-off
+                                 ; (chunk 3 stays HOME: the stock ROM's hand-off runs on its stack there)
+
+; The program image at DOCK $6000 (chunk 3), written by the IDE's packer (tools/pack_cart.py).
+CART_IMAGE       EQU $6000
+CART_IMG_MAGIC   EQU CART_IMAGE      ; 8: "LEAPPROG"
+CART_IMG_FORMAT  EQU CART_IMAGE+8    ; 2: image format (CART_FORMAT)
+CART_IMG_IDENT   EQU CART_IMAGE+10   ; 2: identity of the ROM build the bytecode was compiled on
+CART_IMG_LEN     EQU CART_IMAGE+12   ; 2: bytecode length n
+CART_IMG_COUNTS  EQU CART_IMAGE+14   ; 5: SYM_COUNTS (numbers, strings, arrays, string arrays, labels)
+CART_IMG_CODE    EQU CART_IMAGE+19   ; n: the bytecode, copied to VM_CODE_BASE
+CART_FORMAT      EQU 1
+
+    IFNDEF CART_IDENTITY
+CART_IDENTITY    EQU 0               ; the Makefile passes the release build's identity (cart target)
+    ENDIF
+
+; The five header bytes the stock ROM reads at DOCK $0000 (type 1 = LROS, entry, chunk spec), then
+; a `jp` so that a jump to $0000 restarts the cartridge.
+    MACRO CART_LROS_HEADER
+    DB $00, $01
+    DW CART_COLD_START
+    DB CART_CHUNK_SPEC
+    jp CART_COLD_START
+    ENDM
+
+    ENDIF
diff --git a/kernel/bank/bank.asm b/kernel/bank/bank.asm
index 9abca90..b284410 100644
--- a/kernel/bank/bank.asm
+++ b/kernel/bank/bank.asm
@@ -79,16 +79,25 @@ BANK_PAGE_EXROM_IN:
                                      ; still-active caller put it
                                      ; there) — nothing to do
     ld   a, (PORT_FF_SHADOW)
+    IFDEF V2_CARTRIDGE
+    and  %01111111                   ; CART: bit 7 = 0, the DOCK: Leap's EXROM image is DOCK
+                                     ; chunk 6 (include/v2_cart.inc). Same size as the `or`.
+    ELSE
     or   %10000000                   ; bit 7 only — EXROM, not Dock;
                                      ; bits 0-6 (video mode, INTEN) are
                                      ; not this routine's to touch —
                                      ; same shadow-preserving discipline
                                      ; GFX_SET_MODE already established
+    ENDIF
     ld   (PORT_FF_SHADOW), a
     out  (PORT_SCLD), a
 
+    IFDEF V2_CARTRIDGE
+    ld   a, CART_HSR_RUN             ; CART: chunk 6 and the cartridge's own chunks 0-1
+    ELSE
     ld   a, %01000000                ; bit 6 = chunk 6 only; every
                                      ; other chunk's bit stays 0 (Home)
+    ENDIF
     out  (PORT_BANK_HOME), a
 .already_paged_in:
     ei
@@ -115,6 +124,23 @@ BANK_PAGE_EXROM_OUT:
     ; 47 of 11,232 frames missing from FRAMES over a float loop, 1 without it
     ; (tools/qual/fuse_frames_probe.py). The ISR touches neither BANK_EXROM_DEPTH, PORT_FF_SHADOW
     ; nor the ports, and runs from HOME on a stack outside chunk 6, so where it lands here is moot.)
+    IFDEF V2_CARTRIDGE
+; CART: chunk 6 back to HOME RAM must keep chunks 0-1 DOCK (writing 0 would drop the running code
+; into the stock ROM): $F4 = CART_HSR_PKG. Same 7 bytes from the `ld (BANK_EXROM_DEPTH)` on as the
+; normal build, so every later routine keeps its address. An unbalanced OUT (depth already 0)
+; rewrites the same mapping, which is harmless.
+    ld   a, (BANK_EXROM_DEPTH)
+    or   a
+    jr   z, .depth_zero
+    dec  a
+    ld   (BANK_EXROM_DEPTH), a
+.depth_zero:
+    ei
+    ret  nz                           ; still nested: chunk 6 stays EXROM
+    ld   a, CART_HSR_PKG
+    out  (PORT_BANK_HOME), a
+    ret
+    ELSE
     ld   a, (BANK_EXROM_DEPTH)
     or   a
     jr   z, .depth_already_zero       ; defensive: an unbalanced OUT
@@ -133,6 +159,7 @@ BANK_PAGE_EXROM_OUT:
 .depth_already_zero:
     ei
     ret
+    ENDIF
 
