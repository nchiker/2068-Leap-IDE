diff --git a/tools/cart_check.py b/tools/cart_check.py
new file mode 100644
index 0000000..2ca43a9
--- /dev/null
+++ b/tools/cart_check.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""CART: check that the cartridge build changes only what it means to (include/v2_cart.inc).
+
+Compares build/cart/ with the release build (`make build`):
+  - every symbol of the release build has the same value in the cartridge build, except
+    MATH_RND_SEED (moved off the LROS header) and the local labels of BANK_PAGE_EXROM_OUT;
+  - the images differ only in the reset bytes ($0000-$0007), the two bank routines, the operands of
+    `call MATH_RND_SEED`, the V2_EXROM_ENTRY jump, and the cartridge code in the free space;
+  - the LROS header is what the stock ROM expects.
+So the compiler and the VM, and everything they reference, are byte-identical to the release.
+Exit status 1 on any difference outside those.
+"""
+import re
+import sys
+
+B = "build/"
+
+
+def syms(path):
+    out = {}
+    for line in open(path):
+        m = re.match(r"(\S+): EQU 0x([0-9A-F]+)", line)
+        if m:
+            out[m.group(1)] = int(m.group(2), 16)
+    return out
+
+
+def main():
+    rel = syms(B + "test_basic.sym") | syms(B + "exrom.sym")
+    cart = syms(B + "cart/leap_v2_cart_home.sym") | syms(B + "cart/leap_v2_cart_exrom.sym")
+    bad = []
+    moved_ok = {"MATH_RND_SEED", "CART_IDENTITY"}
+    for name, v in rel.items():
+        if name in moved_ok or name.startswith("BANK_PAGE_EXROM_OUT."):
+            continue
+        if cart.get(name) != v:
+            bad.append(f"symbol {name}: release ${v:04X}, cartridge {cart.get(name)}")
+
+    def allowed_home(a):
+        return (a < 0x0008
+                or cart["BANK_PAGE_EXROM_IN"] <= a < cart["EXT2_CLEAR_ALL"]
+                or a >= cart["CART_COLD_START"])
+
+    def allowed_exrom(a):
+        return (cart["V2_EXROM_ENTRY"] <= a < cart["V2_EXROM_ENTRY"] + 9
+                or a >= cart["CART_RUN"])
+
+    home_r = open("v2_home.bin", "rb").read()
+    home_c = open(B + "cart/leap_v2_cart_home.bin", "rb").read()
+    ex_r = open("v2_exrom.bin", "rb").read()
+    ex_c = open(B + "cart/leap_v2_cart_exrom.bin", "rb").read()
+    seed_r, seed_c = rel["MATH_RND_SEED"], cart["MATH_RND_SEED"]
+    seed_calls = set()
+    for i in range(len(home_r) - 2):
+        if (home_r[i] == 0xCD and home_r[i + 1] | home_r[i + 2] << 8 == seed_r
+                and home_c[i] == 0xCD and home_c[i + 1] | home_c[i + 2] << 8 == seed_c):
+            seed_calls |= {i + 1, i + 2}
+    for a in range(16384):
+        if home_r[a] != home_c[a] and not allowed_home(a) and a not in seed_calls:
+            bad.append(f"HOME byte ${a:04X} differs")
+    for a in range(8192):
+        if ex_r[a] != ex_c[a] and not allowed_exrom(0xC000 + a):
+            bad.append(f"EXROM byte ${0xC000 + a:04X} differs")
+
+    entry = home_c[2] | home_c[3] << 8
+    if home_c[1] != 0x01 or entry != cart["CART_COLD_START"] or home_c[4] != 0xBC:
+        bad.append("LROS header wrong: %s" % home_c[:5].hex())
+
+    for b in bad[:40]:
+        print("cart_check:", b)
+    if bad:
+        sys.exit(1)
+    sig = home_c.find(b"LEAPPROG")
+    print("cart_check: OK -- only the intended bytes differ; image identity $%04X"
+          % (home_c[sig + 10] | home_c[sig + 11] << 8))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/cart_identity.py b/tools/cart_identity.py
new file mode 100755
index 0000000..1b99eaa
--- /dev/null
+++ b/tools/cart_identity.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""CART: print the build identity a cartridge program image must carry (include/v2_cart.inc).
+
+The identity is the CRC-16/CCITT (poly $1021, init $FFFF) of the HOME image followed by the EXROM
+image of the ROM build that compiled the bytecode -- the first part of what SA_ROM_CRC (SAVE ... ALL)
+covers. The cartridge build is built with the identity of the release build from the same source,
+whose compiler and VM it carries byte for byte.
+
+Usage: cart_identity.py HOME.bin EXROM.bin   -> prints e.g. 0x1234
+"""
+import sys
+
+
+def crc16(data, crc=0xFFFF):
+    for b in data:
+        crc ^= b << 8
+        for _ in range(8):
+            crc = ((crc << 1) ^ 0x1021) if crc & 0x8000 else crc << 1
+            crc &= 0xFFFF
+    return crc
+
+
+if __name__ == "__main__":
+    home, exrom = (open(p, "rb").read() for p in sys.argv[1:3])
+    if len(home) != 16384 or len(exrom) != 8192:
+        sys.exit("expected a 16384-byte HOME and an 8192-byte EXROM image")
+    print("0x%04X" % crc16(home + exrom))
