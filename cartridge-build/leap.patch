diff --git a/rom/exrom_v2_cart.asm b/rom/exrom_v2_cart.asm
new file mode 100644
index 0000000..cef4b07
--- /dev/null
+++ b/rom/exrom_v2_cart.asm
@@ -0,0 +1,28 @@
+; ============================================================================
+; rom/exrom_v2_cart.asm -- CART: the EXROM side of the cartridge build (include/v2_cart.inc), in the
+; free space at the end of the EXROM image. V2_EXROM_ENTRY comes here instead of the editor.
+; ============================================================================
+
+; CART_RUN -- load the program image (CART_LOAD, HOME) and run it as RUN does after a successful
+; compile (V2_COMPILE_RUN). When it ends -- normally, with an error or with BREAK -- the message (if
+; any) and a key, then `rst $00`: the cartridge starts again from cold (a program may have POKEd its
+; own bytecode, so the image is copied again).
+; In: from V2_COLD_START / V2_EXROM_ENTRY (memory initialised, PAS_END = ARR2_BASE, depth 1).
+CART_RUN:
+    ld hl,PROG_AREA_START        ; an empty compile symbol table (ARR_RUN_BIND walks nothing, and
+    ld (SYM_BASE_V),hl           ; VM_INIT puts the array arena just above it)
+    ld (SYM_END_V),hl
+    ld (hl),0
+    call CART_LOAD
+    push af
+    call V2_RESET_DISPLAY
+    pop af
+    jr nc,.run
+    call KTAB_GFX_CLS
+    ld hl,CART_MSG_BAD
+    call V2_SHOW_MESSAGE
+    rst $00
+.run:
+    call V2_SESSION_START        ; SESS_CODE_END = EMIT_PTR; VM_INIT; ARR_RUN_INIT
+    call V2_COMPILE_RUN.base     ; VM_IP, CLS, VM_RUN, then the message / a key
+    rst $00
diff --git a/rom/v2_cart_home.asm b/rom/v2_cart_home.asm
new file mode 100644
index 0000000..acf1cdd
--- /dev/null
+++ b/rom/v2_cart_home.asm
@@ -0,0 +1,87 @@
+; ============================================================================
+; rom/v2_cart_home.asm -- CART: the HOME side of the cartridge build (include/v2_cart.inc), in the
+; free space at the end of the HOME image.
+; ============================================================================
+
+; CART_COLD_START -- the LROS entry. The stock ROM jumps here with interrupts ENABLED, IM 1, SP in its
+; own stack ($61FE, chunk 3) and port $F4 already = CART_HSR_RUN (TSRun, stock ROMs, tools/probe). An
+; interrupt before the `di` runs Leap's V2_RST_38 (chunk 0 is DOCK): KBD_ISR_TICK writes only sysvars
+; in $8000-$BFFF, which MEM_COLD_INIT zeroes next, on the stock stack in HOME RAM -- harmless.
+; Then the ordinary cold start: its BANK_PAGE_EXROM_IN (cartridge variant) keeps the DOCK selected,
+; and V2_EXROM_ENTRY goes to CART_RUN instead of the editor.
+CART_COLD_START:
+    di
+    ld a, CART_HSR_RUN
+    out (PORT_BANK_HOME), a
+    xor a
+    out (PORT_SCLD), a               ; DOCK, not EXROM, for every chunk $F4 selects; video mode 0
+; The AY as power-on leaves it (every register 0), which Leap's own boot assumes: the stock ROM has
+; already written to it before the hand-off.
+    ld b, 16
+.ay:
+    ld a, b
+    dec a
+    out (PORT_AY_REG), a
+    xor a
+    out (PORT_AY_DATA), a
+    djnz .ay
+    jp V2_COLD_START
+
+; MATH_RND_SEED -- moved from $0004 (rom/v2_lowrom_fill.asm), where the LROS chunk spec is.
+MATH_RND_SEED:
+    ld   (RND_STATE), hl
+    ret
+
+; CART_LOAD -- map the program image (DOCK chunk 3), check it, copy it, unmap it. Called by CART_RUN
+; (rom/exrom_v2_cart.asm). Copies SYM_COUNTS, the bytecode to VM_CODE_BASE, and sets EMIT_PTR to its
+; end. CF = refused: another image format or ROM build, or a bad length. Interrupts are off while
+; chunk 3 is DOCK and on again at the end. Destroys AF, BC, DE, HL.
+CART_LOAD:
+    di
+    ld a,CART_HSR_LOAD
+    out (PORT_BANK_HOME),a
+    call .copy
+    ld a,CART_HSR_RUN                ; (keeps CF)
+    out (PORT_BANK_HOME),a
+    ei
+    ret
+.copy:
+    ld hl,CART_IMAGE
+    ld de,CART_SIGNATURE
+    ld b,CART_SIGNATURE_END-CART_SIGNATURE
+.sig:
+    ld a,(de)
+    cp (hl)
+    scf
+    ret nz
+    inc hl
+    inc de
+    djnz .sig
+    ld c,(hl)
+    inc hl
+    ld b,(hl)                        ; BC = bytecode length, 1..V2_CODE_SIZE
+    inc hl
+    ld a,b
+    or c
+    scf
+    ret z
+    push hl
+    ld hl,V2_CODE_SIZE
+    sbc hl,bc                        ; (CF clear from the `or`)
+    pop hl
+    ret c
+    ld de,SYM_COUNTS
+    push bc
+    ld bc,5
+    ldir
+    pop bc
+    ld de,VM_CODE_BASE
+    ldir
+    ld (EMIT_PTR),de                 ; CF clear (ldir keeps it)
+    ret
+
+CART_SIGNATURE:
+    DB "LEAPPROG"
+    DW CART_FORMAT, CART_IDENTITY
+CART_SIGNATURE_END:
+CART_MSG_BAD: DB "NO PROGRAM",0
