REM B3 numbers: sieve of Eratosthenes over 2..3999, then an LCG (SPEC.md)
CLS
DIM f(4000)
FOR i = 0 TO 3999
  f(i) = 0
NEXT i
p = 0
FOR i = 2 TO 3999
  IF f(i) = 0 THEN
    p = p + 1
    FOR j = i * 2 TO 3999 STEP i
      f(j) = 1
    NEXT j
  ENDIF
NEXT i
x = 1
s = 0
FOR k = 1 TO 20000
  x = MOD(x * 5 + 3, 32768)
  s = MOD(s + x, 65536)
NEXT k
PRINT "PRIMES "; p
PRINT "X "; x
PRINT "S "; s
REM The results are also left in the attribute bytes of row 10 (22848 = $5940; the
REM bitmap is not compared for B3) so the runner can read them back: marker $A5 last.
POKE 22849, MOD(p, 256)
POKE 22850, DIV(p, 256)
POKE 22851, MOD(x, 256)
POKE 22852, DIV(x, 256)
POKE 22853, MOD(s, 256)
POKE 22854, DIV(s, 256)
POKE 22848, 165
