+    const T = { prov: orig.map((w) => w.prov), fin: orig.map((w) => at.get(w)), len0: orig.map((w) => w.len0), len1: orig.map((w) => (w.dead ? 0 : w.bytes.length + (w.split ? 1 : 0))), total, end: this.buf.length, changed: orig.map((w) => !!(w.was || w.dead)) };
