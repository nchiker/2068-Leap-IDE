+console.log('\n4. The tick costs on the real runtime');
+{
+  const overTicks = got.costs.map((c, i) => [c, i + 1]).filter(([c, k]) => k > 2 && c > 3 * 58688).map(([c, k]) => `tick ${k} (scene ${sceneNames[sc[k - 1]]}${sc[k - 1] !== sc[k - 2] ? ', a scene change' : ''}) ${c} T`);
