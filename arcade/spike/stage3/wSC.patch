+{
+ "sprites": {
+  "ship": {
+   "w": 16,
+   "h": 16,
+   "frames": [
+    {
+     "rows": [
+      {
+       "bits": "0180",
+       "mask": "0180",
+       "ink": 7,
+       "paper": 0,
+       "bright": 0
+      },
+      {
+       "bits": "0180",
+       "mask": "0180",
