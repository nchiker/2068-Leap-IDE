diff --git a/arcade/examples/breakout.arc b/arcade/examples/breakout.arc
index 01f31a3..81f776c 100644
--- a/arcade/examples/breakout.arc
+++ b/arcade/examples/breakout.arc
@@ -1,5 +1,6 @@
 REM Breakout: acceptance game A (docs/ARCADE_LANGUAGE.md), for the v2 runtime.
-REM Assets (bat, ball, bricks, wall, brick, lose) are in breakout.assets.json.
+REM Assets (bat, ball, bricks, wall, brick, lose, the song "theme") are in breakout.assets.json, made by breakout.assets.gen.mjs.
+REM   A title scene (the song plays, and the first rows of bricks as a picture) starts the game with SPACE or fire; the game itself is silent but for the effects.
 REM   Keys O / P (left / right) or joystick 1 move the bat; SPACE or fire restarts after GAME OVER or YOU WIN.
 REM   Six rows of 30 bricks are TILEs (three colours, the upper rows score more); the ball finds a brick with TILEAT.
 REM   Compile:  node arcade/tools/arcadec.mjs arcade/examples/breakout.arc --assets arcade/examples/breakout.assets.json --runtime v2
@@ -12,6 +13,29 @@ TILESET bricks = "bricks"
 SFX wall = "wall"
 SFX brick = "brick"
 SFX lose = "lose"
+MUSIC theme = "theme"
+
+SCENE title
+  PROC INIT():
+    PLAY theme
+    CLS
+    FOR j = 3 TO 5
+      FOR i = 1 TO 30
+        TILE i, j = j - 3
+      NEXT i
+    NEXT j
+    INK 1 : PRINT AT 9, 12; "BREAKOUT";
+    INK 2 : PRINT AT 13, 7; "PRESS FIRE TO PLAY";
+    INK 0 : PRINT AT 17, 2; "O P OR JOYSTICK MOVE THE BAT";
+  ENDP
+
+  REM KEYPRESS and JOYPRESS are true for the one tick the key or the button goes down.
+  PROC FRAME():
+    IF KEYPRESS(" ") OR BIT(JOYPRESS(1), 4) THEN
+      ENTER play
+    ENDIF
+  ENDP
+ENDSCENE
 
 SCENE play
   REM state: 0 = playing, 1 = game over / won (waiting for fire)
@@ -47,6 +71,7 @@ SCENE play
   ENDP
 
   PROC INIT():
+    NOMUSIC
     CALL NEWGAME()
     SHOW bat AT px, 176
     SHOW ball AT bx, by
diff --git a/arcade/examples/breakout.assets.gen.mjs b/arcade/examples/breakout.assets.gen.mjs
new file mode 100644
index 0000000..4c0731c
--- /dev/null
+++ b/arcade/examples/breakout.assets.gen.mjs
@@ -0,0 +1,42 @@
+#!/usr/bin/env node
+"use strict";
+// breakout.assets.gen.mjs -- adds the title song to breakout.assets.json (the sprites, the bricks and the sound effects stay as they are).
+//   node arcade/examples/breakout.assets.gen.mjs            write breakout.assets.json
+//   node arcade/examples/breakout.assets.gen.mjs --check    write nothing; exit 1 when breakout.assets.json is not what the generator makes
+// Deterministic. It reads the JSON, replaces only `music`, writes it back (indented with one space).
+//   music    theme  eight bars in D minor (two patterns, played once round and then again), a quaver = 8 refreshes, a bar = 64; original; written with songs.mjs
+import { writeFileSync, readFileSync, existsSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { pattern, song, describe } from './songs.mjs';
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const out = join(HERE, 'breakout.assets.json');
+const assets = JSON.parse(readFileSync(out, 'utf8'));
+delete assets.music;
+
+const DRUMS = 'C2:4 -:12 G5:4 -:12 C2:4 -:4 C2:4 -:4 G5:4 -:12';       // 64 refreshes
+const bars = (s, n) => Array(n).fill(s).join(' ');
+assets.music = {
+  theme: song([
+    pattern({
+      A: '@organ !11 L8 | D5 D5 F5 D5 A5:16 F5 D5 | C5 C5 E5 C5 G5:16 E5 C5 | Bb4 Bb4 D5 Bb4 F5:16 D5 Bb4 | A4 A4 C#5 A4 E5:16 C#5 A4',
+      B: '@bass !11 L16 | D2 D3 D2 D3 | C2 C3 C2 C3 | Bb1 Bb2 Bb1 Bb2 | A1 A2 A1 A2',
+      C: '@drum !9 ' + bars(DRUMS, 4),
+    }, 'charge'),
+    pattern({
+      A: '@organ !12 L8 | F5:16 A5:16 G5:16 F5:16 | E5:16 G5:16 F5:16 E5:16 | D5:16 F5:16 E5:16 C#5:16 | D5:48 -:16',
+      B: '@bass !11 L16 | D2 D3 D2 D3 | C2 C3 C2 C3 | Bb1 Bb2 A1 A2 | D2 D3 D2 D3',
+      C: '@drum !9 ' + bars(DRUMS, 4),
+    }, 'answer'),
+  ], [0, 1], 0),
+};
+
+const text = JSON.stringify(assets, null, 1) + '\n';
+if (process.argv.includes('--check')) {
+  const same = existsSync(out) && readFileSync(out, 'utf8') === text;
+  console.log(same ? 'breakout.assets.json is up to date' : 'breakout.assets.json is OUT OF DATE: run node arcade/examples/breakout.assets.gen.mjs');
+  process.exit(same ? 0 : 1);
+}
+writeFileSync(out, text);
+console.log(`breakout.assets.json: ${Object.keys(assets.sprites).length} sprites, ${Object.keys(assets.sfx).length} sound effects; ${Object.entries(assets.music).map(([k, v]) => describe(k, v)).join('; ')}`);
