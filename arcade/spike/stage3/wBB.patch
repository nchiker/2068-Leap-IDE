diff --git a/arcade/examples/bounce.arc b/arcade/examples/bounce.arc
index 2400c0e..313966e 100644
--- a/arcade/examples/bounce.arc
+++ b/arcade/examples/bounce.arc
@@ -1,15 +1,38 @@
 REM Bounce: a ball bouncing off the screen edges and a paddle the joystick moves along the bottom.
-REM Arcade v0 subset. Assets (ball, paddle) are in bounce.assets.json.
+REM The smallest example: a title scene with a song, then the play scene.
+REM Assets (ball, paddle, the song "theme") are in bounce.assets.json, which bounce.assets.gen.mjs makes.
 GAME "bounce"
 FRAMERATE 30
 
 SPRITE ball = "ball"
 SPRITE paddle = "paddle"
+MUSIC theme = "theme"
+
+REM The title: the song plays until fire (the SPACE key or the joystick's button) starts the game.
+SCENE title
+  PROC INIT():
+    PLAY theme
+    CLS
+    INK 1 : PRINT AT 8, 13; "BOUNCE";
+    INK 2 : PRINT AT 12, 7; "PRESS FIRE TO PLAY";
+    INK 0 : PRINT AT 16, 7; "O P OR JOYSTICK 1";
+    PRINT AT 17, 8; "MOVE THE PADDLE";
+  ENDP
+
+  REM KEYPRESS and JOYPRESS are true for the one tick the key or the button goes down.
+  PROC FRAME():
+    IF KEYPRESS(" ") OR BIT(JOYPRESS(1), 4) THEN
+      ENTER play
+    ENDIF
+  ENDP
+ENDSCENE
 
 SCENE play
   DIM bx, by, dx, dy, px
 
   PROC INIT():
+    NOMUSIC
+    CLS
     bx = 120
     by = 60
     dx = 2
diff --git a/arcade/examples/bounce.assets.gen.mjs b/arcade/examples/bounce.assets.gen.mjs
new file mode 100644
index 0000000..0a72ea9
--- /dev/null
+++ b/arcade/examples/bounce.assets.gen.mjs
@@ -0,0 +1,37 @@
+#!/usr/bin/env node
+"use strict";
+// bounce.assets.gen.mjs -- adds the title song to bounce.assets.json (the ball and paddle sprites stay as they are).
+//   node arcade/examples/bounce.assets.gen.mjs            write bounce.assets.json
+//   node arcade/examples/bounce.assets.gen.mjs --check    write nothing; exit 1 when bounce.assets.json is not what the generator makes
+// Deterministic. It reads the JSON, replaces only `music`, writes it back (indented with one space).
+//   music    theme  four bars in C major (C - Am - F - G), a quaver = 8 refreshes, a bar = 64; original; written with songs.mjs
+import { writeFileSync, readFileSync, existsSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { pattern, song, describe } from './songs.mjs';
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const out = join(HERE, 'bounce.assets.json');
+const assets = JSON.parse(readFileSync(out, 'utf8'));
+delete assets.music;
+
+const DRUMS = 'C2:4 -:12 G5:4 -:12';                                   // a beat every 16 refreshes
+const bars = (s, n) => Array(n).fill(s).join(' ');
+assets.music = {
+  theme: song([
+    pattern({
+      A: '@organ !11 L8 | C5 E5 G5 E5 C5 E5 G5:16 | A4 C5 E5 C5 A4 C5 E5:16 | F4 A4 C5 A4 F5 E5 D5:16 | G4 B4 D5 B4 G4 D5 G5:16',
+      B: '@bass !11 L32 | C3 G3 | A2 E3 | F2 C3 | G2 D3',
+      C: '@drum !9 ' + bars(DRUMS, 8),
+    }, 'bounce'),
+  ], [0], 0),
+};
+
+const text = JSON.stringify(assets, null, 1) + '\n';
+if (process.argv.includes('--check')) {
+  const same = existsSync(out) && readFileSync(out, 'utf8') === text;
+  console.log(same ? 'bounce.assets.json is up to date' : 'bounce.assets.json is OUT OF DATE: run node arcade/examples/bounce.assets.gen.mjs');
+  process.exit(same ? 0 : 1);
+}
+writeFileSync(out, text);
+console.log(`bounce.assets.json: ${Object.keys(assets.sprites).length} sprites; ${Object.entries(assets.music).map(([k, v]) => describe(k, v)).join('; ')}`);
